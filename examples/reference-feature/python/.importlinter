[importlinter]
root_package = modules

[importlinter:contract:domain-is-a-sink]
name = Domain does not import api or persistence
type = forbidden
source_modules =
    modules.orders.domain
forbidden_modules =
    modules.orders.api
    modules.orders.persistence

[importlinter:contract:api-does-not-import-persistence]
name = Api does not import persistence
type = forbidden
source_modules =
    modules.orders.api
forbidden_modules =
    modules.orders.persistence
