# Example selected layout, not required directories. Public API = api package.
# Orders owns orders; billing owns invoices. Selected direction: billing -> orders.
# Replace owners, API paths and direction together; test allowed and forbidden edges.
[importlinter]
root_package = modules

[importlinter:contract:orders-private]
name = Billing uses only orders API
type = forbidden
source_modules =
    modules.billing
forbidden_modules =
    modules.orders.domain
    modules.orders.persistence
allow_indirect_imports = True

[importlinter:contract:billing-private]
name = Orders cannot reach billing internals
type = forbidden
source_modules =
    modules.orders
forbidden_modules =
    modules.billing.domain
    modules.billing.persistence
allow_indirect_imports = True

[importlinter:contract:owner-direction]
name = Billing may depend on orders, never the reverse
type = layers
layers =
    modules.billing
    modules.orders

# This owner DAG does not detect every cycle inside an owner. Add a cycle check
# if required by repository policy. Owner-local tests may import their internals.
