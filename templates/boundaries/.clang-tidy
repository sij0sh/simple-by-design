# Shared clang-tidy starter for C and C++. Copy to the repository root.
# Keep checks that apply to both languages; modernize-* is C++ only.

Checks: >
  -*,
  bugprone-*,
  misc-*,
  performance-*,
  portability-*,
  readability-*,
  -bugprone-easily-swappable-parameters,
  -misc-non-private-member-variables-in-classes,
  -readability-identifier-length,
  -readability-magic-numbers
WarningsAsErrors: ''
HeaderFilterRegex: '.*'
FormatStyle: file
